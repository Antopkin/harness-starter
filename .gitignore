# Secrets and environment: NEVER commit
.env
.env.*
*.env
*credentials*
*secret*
*token*
# Memory notes may carry those words in their names; the rule forbids secrets in them.
!memory/*.md
*.key
*.pem
# MCP configuration with your API keys (the template .mcp.json.example stays tracked)
.mcp.json

# Personal, machine-local settings (Claude Code)
.claude/settings.local.json
CLAUDE.local.md

# Installed copies of skills and agent roles; the sources are skills/, agents/ and hooks/.
# .claude/settings.json stays tracked: it wires the guards for Claude Code.
.claude/skills/
.claude/agents/
.agents/
.opencode/

# Plans and wayfinder maps: remove to version your plans and maps
plans/

# Tool and agent caches
.ruff_cache/
.mypy_cache/
.pytest_cache/
__pycache__/
*.pyc
.venv/
venv/
node_modules/
.DS_Store
.playwright-mcp/

# Your own materials and media (they go into materials/ but are not versioned)
materials/*
!materials/.gitkeep
*.pdf
*.png
*.jpg
*.jpeg
*.gif
*.mp4
*.mov
*.zip
*.docx
skills/digest/references/*.docx

# Proprietary Anthropic skills (pdf, docx, pptx, xlsx): you may use them locally, but you may NOT publish them (see their LICENSE.txt). Keep them untracked.
skills/pdf/
skills/docx/
skills/pptx/
skills/xlsx/
